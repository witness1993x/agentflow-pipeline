# Lark / Feishu group bot webhook URL — REQUIRED for --notify-lark to do anything.
# Get it from your Lark group → 设置 → 群机器人 → 添加 → 自定义机器人 → 复制 URL
LARK_WEBHOOK_URL=

# Optional: HMAC secret. Set this when your bot has '签名校验' enabled.
LARK_WEBHOOK_SECRET=

# Optional: comma-separated keywords. Set when your bot has '自定义关键词' enabled —
# the framework auto-appends the first keyword to text bodies that don't include any.
LARK_WEBHOOK_KEYWORDS=AgentFlow,热点扫描

# Optional: short brand prefix prepended to every card title (e.g. "ChainStream" → "[ChainStream] 🔎 …").
LARK_WEBHOOK_BRAND_PREFIX=

# Optional: set "true" to bypass the HH:00 / HH:30 ±60s deferral that dodges Lark's
# 11232 系统压力 rate-limit. Leave unset for the safe default.
LARK_WEBHOOK_NO_DEFER=

# Optional: set "true" to build the card payload but skip the actual POST. Useful for cron debug.
LARK_WEBHOOK_DRY_RUN=

# Optional: Telegram bot username for Lark Custom Bot CTA bridge.
# When set, the auto-promoted-case button in Lark links to:
#   https://t.me/<bot>?start=case_HSP-XXX_dry_publish
# This does not change the Lark webhook protocol; it only changes one URL button.
LARK_CTA_TG_BOT=

# ---------------------------------------------------------------------------
# Auto-promote (level B half-automation) — optional
# ---------------------------------------------------------------------------
# These are NOT environment variables. They are CLI flags passed to
# agentflow-scan via --scan-args. Documented here for discoverability.
#
#   --auto-promote                    : enable promotion (dry-run only)
#   --auto-promote-apply              : the real-create double flag
#   --auto-promote-max N              : safety cap, default 1
#   --auto-promote-min-engagement N   : engagement floor, default 150
#   --auto-promote-owner OWNER        : owner string, default 'agentflow-auto'
#   --auto-promote-baseline-window N  : how many past scans count as
#                                       "history" for new-entry detection,
#                                       default 14 (≈ 1 week at 2 scans/day)
#
# To enable on the daily 10:00 job, re-run agentflow-schedule install with:
#   --scan-args="--notify-lark --auto-promote --auto-promote-apply"

# ---------------------------------------------------------------------------
# Telegram bot (push + callback) — optional
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required when running agentflow-tg-listen daemon — random ≥16-char string
# prefixed to every callback_data so spoofed clicks are rejected.
TELEGRAM_CALLBACK_SECRET=

# Optional: comma-separated chat_id whitelist for the listener daemon.
# Leave empty to allow any chat the bot is in.
TELEGRAM_CHAT_ID_ALLOWLIST=

# Optional: name your bot here only as documentation. Use LARK_CTA_TG_BOT above
# when you want Lark cards to deep-link into this bot.
# TELEGRAM_BOT_USERNAME=@your_bot_name
